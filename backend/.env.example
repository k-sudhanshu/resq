# Copy to .env for local development. Never commit the real .env.

ENVIRONMENT=local

# Local default is SQLite, which needs no install and no Docker.
# Production uses Postgres, e.g.
#   postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./resq.db

# `mock` everywhere except production, so development never spends the free
# Gemini quota. Switch to `gemini` only with a real key.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Daily cap on real AI calls, kept below the provider's free daily quota.
DAILY_AI_BUDGET=200

ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_SECRET=change-me-before-deploying

# Relaxed for local development only. Every browser tab and every test run
# creates a session, so the production defaults (10 per IP per hour, 5
# analyses per session per minute, set in app/core/settings.py) block ordinary
# iteration within minutes. Do not carry these values to production.
SESSIONS_PER_IP_PER_HOUR=500
ANALYSES_PER_SESSION_PER_MINUTE=60

LOG_LEVEL=INFO
